# ==============================================================================
# PRIME HOUSE REAL ESTATE PORTAL - CONFIGURATION ENVIRONNEMENT
# Copiez ce fichier sous le nom '.env' et renseignez vos clés Supabase
# ==============================================================================

# Port d'écoute du serveur Node.js (défaut: 3000)
PORT=3000

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique Supabase (Anon Key) - Utilisée côté client et requêtes publiques RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Clé Secrète de Service Supabase (Service Role Key) - Opérations administratives sécurisées
# ATTENTION : Ne jamais exposer cette clé côté client !
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Secret pour la signature des sessions de console d'administration
ADMIN_SESSION_SECRET=prime_house_super_secure_session_secret_2026_dz
